[user]
	name = Agus Darmawan
	email = darmawandeveloper@gmail.com

[core]
	editor = nvim
	# delta when installed, plain less otherwise (fresh containers, robots)
	pager = "command -v delta >/dev/null && exec delta || exec less -R"
	autocrlf = input
	excludesfile = ~/.config/git/ignore

[interactive]
	diffFilter = "command -v delta >/dev/null && exec delta --color-only || exec cat"

[delta]
	navigate = true
	dark = true
	line-numbers = true
	side-by-side = false
	hyperlinks = true

[init]
	defaultBranch = main

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true

[push]
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true

[merge]
	conflictstyle = diff3

[diff]
	algorithm = histogram
	colorMoved = default

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[help]
	autocorrect = prompt

[alias]
	st = status -sb
	lg = log --graph --pretty=format:'%C(magenta)%h%Creset %C(blue)%ad%Creset %s%C(yellow)%d%Creset %C(dim)%an' --date=short
	last = log -1 HEAD --stat
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	unstage = restore --staged
	wip = !git add -A && git commit -m 'chore: wip'
	branches = branch -a -vv
	who = shortlog -sn --no-merges

# machine/work-specific overrides (e.g. work email per directory)
[include]
	path = ~/.config/git/config.local
