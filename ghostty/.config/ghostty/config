# ─────────────────────────────────────────────────────────────
#  Ghostty — agus-darmawan/dotfiles
#  Reload: cmd+shift+,   |   List themes: ghostty +list-themes
# ─────────────────────────────────────────────────────────────

# ── Font ─────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 2

# ── Theme (matches tmux / nvim / starship palette) ───────────
theme = Catppuccin Mocha
background-opacity = 0.96
background-blur = 20
unfocused-split-opacity = 0.85
minimum-contrast = 1.1

# ── Window ───────────────────────────────────────────────────
window-padding-x = 10
window-padding-y = 6
window-padding-balance = true
window-save-state = always
window-inherit-working-directory = true
macos-titlebar-style = tabs
macos-option-as-alt = left
confirm-close-surface = false
quit-after-last-window-closed = true

# ── Cursor & mouse ───────────────────────────────────────────
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard

# ── Clipboard (OSC52 from tmux / nvim / ssh sessions) ────────
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# ── Shell integration ────────────────────────────────────────
# ssh-terminfo: installs xterm-ghostty terminfo on remote hosts automatically
# ssh-env     : falls back to xterm-256color when it can't
shell-integration-features = no-cursor,ssh-terminfo,ssh-env

# ── Quick terminal (drop-down, from anywhere) ────────────────
# Needs: System Settings → Privacy & Security → Accessibility → Ghostty
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-animation-duration = 0.12
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ── Splits (Ghostty-native, when not using tmux) ─────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:bottom
keybind = cmd+alt+k=goto_split:top
keybind = cmd+alt+l=goto_split:right
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# ── Misc ─────────────────────────────────────────────────────
keybind = cmd+shift+comma=reload_config
keybind = shift+enter=text:\x1b\r
auto-update = check

# ── Optional: "tmux mode" ────────────────────────────────────
# Uncomment to drive tmux with cmd-keys (prefix is ctrl+a = \x01).
# Overrides Ghostty tabs on cmd+t / cmd+1..9.
